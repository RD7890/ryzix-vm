<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Pure Compose app (ComponentActivity, no AppCompat).
        Parent must be a *public* platform theme — Theme.Material.Light.NoActionBar
        is listed in android/res/values/public.xml since API 21.
        Fullscreen is achieved via windowFullscreen + windowNoTitle items.
        Compose draws everything; this XML theme just configures the window.
    -->
    <style name="Theme.RyzixVM" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
